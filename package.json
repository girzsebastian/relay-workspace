{
  "name": "relay-workspace",
  "productName": "Relay",
  "version": "0.5.1",
  "private": true,
  "description": "A persistent desktop workspace for projects, terminals, and AI conversations.",
  "author": "Relay contributors",
  "license": "AGPL-3.0-or-later",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "format": "prettier --write app desktop scripts tests docs README.md CONTRIBUTING.md package.json tsconfig.json vite.config.mjs .github",
    "format:check": "prettier --check app desktop scripts tests docs README.md CONTRIBUTING.md package.json tsconfig.json vite.config.mjs .github",
    "test:package": "node scripts/package-check.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.41.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "dev.relay.workspace",
    "productName": "Relay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build-resources/icon.png"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
